rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: Check if user is admin ──
    function isAdmin() {
      return request.auth != null && request.auth.token.email_verified == true && request.auth.token.email == 'walletpro26@gmail.com';
    }

    // ── Helper: Check if user owns the document (checks both userId and uid) ──
    function isOwner() {
      return request.auth != null && (
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.get('uid', '') == request.auth.uid
      );
    }

    function isNewOwner() {
      return request.auth != null && (
        request.resource.data.get('userId', '') == request.auth.uid ||
        request.resource.data.get('uid', '') == request.auth.uid
      );
    }

    // ── Expenses ──
    match /expenses/{docId} {
      allow read: if request.auth != null && (isOwner() || isAdmin());
      allow create: if request.auth != null && (isNewOwner() || isAdmin());
      allow update: if request.auth != null && ((isOwner() && isNewOwner()) || isAdmin());
      allow delete: if request.auth != null && (isOwner() || isAdmin());

      // Attachment chunks subcollection
      match /attachmentChunks/{chunkId} {
        allow read, write: if request.auth != null && (
          get(/databases/$(database)/documents/expenses/$(docId)).data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/expenses/$(docId)).data.uid == request.auth.uid ||
          isAdmin()
        );
      }
    }

    // ── Lending ──
    match /lending/{docId} {
      allow read: if request.auth != null && (isOwner() || isAdmin());
      allow create: if request.auth != null && (isNewOwner() || isAdmin());
      allow update: if request.auth != null && ((isOwner() && isNewOwner()) || isAdmin());
      allow delete: if request.auth != null && (isOwner() || isAdmin());

      // Attachment chunks subcollection
      match /attachmentChunks/{chunkId} {
        allow read, write: if request.auth != null && (
          get(/databases/$(database)/documents/lending/$(docId)).data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/lending/$(docId)).data.uid == request.auth.uid ||
          isAdmin()
        );
      }
    }

    // ── Bank Transactions ──
    match /bankTransactions/{docId} {
      allow read: if request.auth != null && (isOwner() || isAdmin());
      allow create: if request.auth != null && (isNewOwner() || isAdmin());
      allow update: if request.auth != null && ((isOwner() && isNewOwner()) || isAdmin());
      allow delete: if request.auth != null && (isOwner() || isAdmin());
    }

    // ── Subscriptions ──
    match /subscriptions/{userId} {
      function ownSubscription() {
        return request.auth != null && userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      }
      function safeTrial() {
        return request.resource.data.status == 'active' &&
          request.resource.data.plan == 'trial' &&
          request.resource.data.gateway == 'free_trial' &&
          request.resource.data.trialClaimed == true &&
          request.resource.data.amountPaid == 0 &&
          request.resource.data.expiresAt > request.time &&
          request.resource.data.expiresAt <= request.time + duration.value(3, 'd') &&
          request.resource.data.get('isAdmin', false) == false &&
          request.resource.data.get('adminActivated', false) == false;
      }
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        isAdmin() ||
        (request.auth.token.email != null && (
          userId == request.auth.token.email ||
          resource.data.email == request.auth.token.email
        ))
      );
      allow create: if isAdmin() || (ownSubscription() && (
        (request.resource.data.status == 'inactive' && request.resource.data.plan == 'free' &&
          request.resource.data.keys().hasOnly(['userId', 'uid', 'email', 'name', 'status', 'plan', 'gateway', 'adminActivated', 'createdAt', 'updatedAt']) &&
          request.resource.data.adminActivated == false && request.resource.data.gateway == 'none') || safeTrial()
      ));
      allow update: if isAdmin() || (ownSubscription() &&
        resource.data.get('trialClaimed', false) == false && safeTrial() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'userId', 'email', 'status', 'plan', 'amountPaid', 'currency', 'paidAt', 'expiresAt', 'gateway', 'trialClaimed', 'updatedAt'
        ]));
      allow delete: if isAdmin();
    }

    // ── UPI Payments ──
    match /upi_payments/{orderId} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        resource.data.email == request.auth.token.email ||
        isAdmin()
      );
      allow create, update, delete: if isAdmin();
    }

    // ── App Config (readable by all users/visitors, writable by admin) ──
    match /appConfig/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── User Profiles (admin reads all, users read/write own) ──
    match /userProfiles/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId || isAdmin()
      );
      allow write: if request.auth != null && (
        request.auth.uid == userId || isAdmin()
      );
    }

    // ── User Sessions (single device concurrent session enforcement) ──
    match /userSessions/{userId} {
      allow read, write: if request.auth != null && (
        request.auth.uid == userId || isAdmin()
      );
    }

    // ── Scheduled Reminders (admin full access, users own) ──
    match /scheduledReminders/{docId} {
      allow read: if request.auth != null && (isOwner() || isAdmin());
      allow create: if request.auth != null && (isNewOwner() || isAdmin());
      allow update: if request.auth != null && ((isOwner() && isNewOwner()) || isAdmin());
      allow delete: if request.auth != null && (isOwner() || isAdmin());
    }

    // ── App Reviews & Reviews (admin reads all, users write/update own) ──
    match /appReviews/{docId} {
      allow read: if request.auth != null || isAdmin();
      allow create: if request.auth != null && (isNewOwner() || isAdmin());
      allow update: if request.auth != null && ((isOwner() && isNewOwner()) || isAdmin());
      allow delete: if request.auth != null && (isOwner() || isAdmin());
    }

    match /reviews/{docId} {
      allow read: if request.auth != null || isAdmin();
      allow create: if request.auth != null && (isNewOwner() || isAdmin());
      allow update: if request.auth != null && ((isOwner() && isNewOwner()) || isAdmin());
      allow delete: if request.auth != null && (isOwner() || isAdmin());
    }

    // ── Activity Logs (admin only read, authenticated write) ──
    match /activityLogs/{docId} {
      allow read: if isAdmin();
      allow create: if request.auth != null && isNewOwner();
      allow update, delete: if isAdmin();
    }

    // ── Linked Banks (read by doc owner / admin, write server-only via Admin SDK) ──
    match /linkedBanks/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if false;
    }
  }
}
